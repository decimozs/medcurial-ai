{
  "name": "@medcurial/api",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "generate": "bunx drizzle-kit generate",
    "migrate": "bunx drizzle-kit migrate",
    "push": "bunx drizzle-kit push",
    "studio": "bunx drizzle-kit studio --port=3001"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@loglayer/hono": "^2.3.0",
    "@loglayer/transport-simple-pretty-terminal": "^3.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.110.0",
    "better-auth": "^1.6.23",
    "bufferutil": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.27",
    "loglayer": "^9.3.0",
    "nanoid": "^5.1.16",
    "postgres": "^3.4.9",
    "serialize-error": "^13.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
